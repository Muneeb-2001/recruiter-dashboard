/* =========================================
   RECRUITER DASHBOARD
   ========================================= */

.recruiter-page {
  min-height: 100vh;
  padding: 42px 5%;
  background:
    radial-gradient(circle at 90% 0%, rgba(47, 106, 246, 0.08), transparent 25%),
    #f6f8fc;
  color: #102044;
}

.recruiter-header {
  max-width: 1250px;
  margin: 0 auto 30px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 25px;
}

.recruiter-eyebrow {
  margin: 0 0 8px;
  color: #3268e8;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.recruiter-header h1 {
  margin: 0;
  font-size: 36px;
  letter-spacing: -1.5px;
}

.recruiter-subtitle {
  margin: 8px 0 0;
  color: #71819d;
  font-size: 14px;
}

.candidate-link {
  padding: 11px 16px;
  border: 1px solid #d6dfef;
  border-radius: 10px;
  background: white;
  color: #3268e8;
  text-decoration: none;
  font-size: 13px;
  font-weight: 700;
}

.stats-grid {
  max-width: 1250px;
  margin: 0 auto 25px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.stat-card {
  padding: 22px;
  border: 1px solid #e0e6f0;
  border-radius: 16px;
  background: white;
  box-shadow: 0 8px 25px rgba(30, 55, 100, 0.05);
}

.stat-card span {
  display: block;
  color: #7d8ca6;
  font-size: 12px;
  font-weight: 600;
}

.stat-card strong {
  display: block;
  margin-top: 9px;
  color: #15274a;
  font-size: 28px;
}

.candidate-panel {
  max-width: 1250px;
  margin: 0 auto;
  overflow: hidden;
  border: 1px solid #e0e6f0;
  border-radius: 18px;
  background: white;
  box-shadow: 0 10px 30px rgba(30, 55, 100, 0.05);
}

.panel-header {
  padding: 23px 25px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #edf1f6;
}

.panel-header h2 {
  margin: 0;
  font-size: 19px;
}

.panel-header p {
  margin: 5px 0 0;
  color: #8794a9;
  font-size: 12px;
}

.refresh-button {
  padding: 9px 15px;
  border: 1px solid #d6dfef;
  border-radius: 9px;
  background: white;
  color: #3268e8;
  font-weight: 700;
  cursor: pointer;
}

.empty-state {
  min-height: 300px;
  padding: 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-icon {
  width: 54px;
  height: 54px;
  margin-bottom: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15px;
  background: #edf3ff;
  color: #3268e8;
  font-size: 27px;
}

.empty-state h3 {
  margin: 0;
  font-size: 17px;
}

.empty-state p {
  max-width: 400px;
  margin: 8px 0 0;
  color: #8794a9;
  font-size: 13px;
  line-height: 1.6;
}

.loading-spinner {
  width: 25px;
  height: 25px;
  margin-bottom: 12px;
  border: 3px solid #dce6f8;
  border-top-color: #3268e8;
  border-radius: 50%;
  animation: recruiter-spin 0.7s linear infinite;
}

@keyframes recruiter-spin {
  to {
    transform: rotate(360deg);
  }
}

.candidate-table {
  width: 100%;
}

.table-row {
  min-height: 62px;
  padding: 0 25px;
  display: grid;
  grid-template-columns: 1.4fr 1.5fr 1fr 0.7fr;
  align-items: center;
  border-bottom: 1px solid #edf1f6;
  color: #344766;
  font-size: 13px;
}

.table-heading {
  min-height: 48px;
  background: #fafbfe;
  color: #8794a9;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

@media (max-width: 800px) {
  .recruiter-page {
    padding: 25px 16px;
  }

  .recruiter-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .table-row {
    grid-template-columns: 1.3fr 1.5fr 1fr;
  }

  .table-row span:last-child {
    display: none;
  }
}

@media (max-width: 520px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .recruiter-header h1 {
    font-size: 30px;
  }
}

.select-wrapper {
  position: relative;
  width: 100%;
}

.select-wrapper select {
  width: 100%;
  height: 54px;
  appearance: none;
  -webkit-appearance: none;
  border: 1px solid #d9e1ef;
  border-radius: 14px;
  background: linear-gradient(180deg, #ffffff 0%, #f8faff 100%);
  color: #14213d;
  padding: 0 48px 0 16px;
  font-size: 15px;
  font-weight: 500;
  outline: none;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 3px 12px rgba(20, 33, 61, 0.04);
}

.select-wrapper select:hover {
  border-color: #9db8f5;
  box-shadow: 0 5px 18px rgba(37, 99, 235, 0.08);
}

.select-wrapper select:focus {
  border-color: #356cf3;
  box-shadow: 0 0 0 4px rgba(53, 108, 243, 0.12);
}

.select-wrapper select:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.select-wrapper select option {
  color: #14213d;
  background: #ffffff;
  font-weight: 500;
}

.select-arrow {
  position: absolute;
  right: 17px;
  top: 50%;
  transform: translateY(-55%);
  pointer-events: none;
  font-size: 21px;
  line-height: 1;
  color: #356cf3;
  font-weight: 700;
}

